---
// GA4。PUBLIC_GA_ID が設定されているときだけ出力する（= 本番のみ作動）。
// CF Pages の環境変数 PUBLIC_GA_ID=G-XXXXXXXXXX を設定 → 再デプロイで有効化。
const gaId = import.meta.env.PUBLIC_GA_ID;
---

{gaId && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      // ClientRouter（View Transitions）でも二重初期化しないようガード
      if (!window.__gaInit) {
        window.__gaInit = true;
        gtag('js', new Date());
        // 自動 page_view は止め、遷移ごとに手動送信する
        gtag('config', gaId, { send_page_view: false });
        document.addEventListener('astro:page-load', () => {
          gtag('event', 'page_view', {
            page_title: document.title,
            page_location: location.href,
            page_path: location.pathname + location.search,
          });
        });
      }
    </script>
  </>
)}
