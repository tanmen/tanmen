---
import { SITE, NAV } from '../site.config';

const path = Astro.url.pathname;
const items = NAV.filter((n) => n.href !== '/');
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="border-b border-white/10">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-5 py-4">
    <a href="/" class="font-mono text-lg font-bold tracking-tight hover:text-accent">{SITE.title}</a>
    <nav class="flex gap-4 text-sm text-muted">
      {items.map((n) => (
        <a href={n.href} class:list={['hover:text-fg', { 'text-fg': isActive(n.href) }]}>{n.label}</a>
      ))}
    </nav>
  </div>
</header>
