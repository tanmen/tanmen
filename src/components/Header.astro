---
import { SITE, NAV } from '../site.config';

const path = Astro.url.pathname;
const items = NAV.filter((n) => n.href !== '/');
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/85 backdrop-blur-sm">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-5 py-3">
    <a href="/" class="group flex items-center gap-1.5 font-mono text-sm">
      <span class="text-led">●</span>
      <span class="text-faint">~/</span>
      <span class="font-display text-base text-fg transition-colors group-hover:text-amber">{SITE.title.toLowerCase()}</span>
      <span class="text-phosphor">❯</span>
    </a>
    <nav class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs">
      {items.map((n) => (
        <a
          href={n.href}
          class:list={['transition-colors', isActive(n.href) ? 'text-amber' : 'text-muted hover:text-fg']}
        >
          {isActive(n.href) && <span class="text-faint">›</span>}{n.label.toLowerCase()}
        </a>
      ))}
    </nav>
  </div>
</header>
