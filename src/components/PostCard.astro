---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, pubDate, tags } = post.data;
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<a
  href={`/posts/${post.id}`}
  class="row group flex flex-col gap-1 px-4 py-3.5 sm:flex-row sm:items-baseline sm:gap-4"
>
  <time datetime={fmt(pubDate)} class="shrink-0 font-mono text-xs text-faint">{fmt(pubDate)}</time>
  <span class="min-w-0 flex-1">
    <span class="font-mono text-sm text-phosphor opacity-50 transition-opacity group-hover:opacity-100">❯ </span>
    <span class="text-fg transition-colors group-hover:text-amber">{title}</span>
  </span>
  {tags.length > 0 && (
    <span class="hidden shrink-0 gap-2 font-mono text-[0.65rem] text-faint sm:flex">
      {tags.map((t) => <span>#{t}</span>)}
    </span>
  )}
</a>
