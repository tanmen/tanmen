---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../site.config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  fullscreen?: boolean;
}

const { title, description = SITE.description, fullscreen = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} — 怠惰なプログラマーのサイト`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="canonical" href={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05060a" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <Analytics />
    <ClientRouter />
  </head>
  <body class:list={['flex flex-col antialiased', fullscreen ? 'h-dvh overflow-hidden' : 'min-h-dvh']}>
    {!fullscreen && <Header />}
    <main class:list={[fullscreen ? 'min-h-0 flex-1' : 'mx-auto w-full max-w-3xl flex-1 px-5 py-12 md:py-16']}>
      <slot />
    </main>
    {!fullscreen && <Footer />}

    <div class="crt-scanlines" aria-hidden="true"></div>
    <div class="crt-grain" aria-hidden="true"></div>
  </body>
</html>
