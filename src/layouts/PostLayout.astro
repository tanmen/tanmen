---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, pubDate, updatedDate, tags } = post.data;
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout title={title} description={title}>
  <article>
    <p class="mb-4 font-mono text-xs text-faint">
      <a href="/posts" class="link-p">~/posts</a> / {post.id}
    </p>

    <header class="mb-8 border-b border-line pb-6">
      {tags.length > 0 && (
        <div class="mb-4 flex flex-wrap gap-2">
          {tags.map((t) => (
            <a href={`/posts/tags/${t}`} class="tag">#{t}</a>
          ))}
        </div>
      )}
      <h1 class="text-2xl leading-snug text-fg sm:text-3xl">{title}</h1>
      <p class="mt-3 font-mono text-xs text-faint">
        <span class="text-phosphor">●</span>
        <time datetime={fmt(pubDate)}>{fmt(pubDate)}</time>
        {updatedDate && <span> · updated {fmt(updatedDate)}</span>}
      </p>
    </header>

    <div class="prose prose-invert article max-w-none">
      <slot />
    </div>
  </article>

  <nav class="mt-12 border-t border-line pt-6 font-mono text-sm">
    <a href="/posts" class="link-p">❯ cd ~/posts</a>
  </nav>
</BaseLayout>
