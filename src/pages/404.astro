---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404">
  <section class="py-10">
    <div class="panel overflow-hidden">
      <div class="flex items-center gap-2 border-b border-line bg-bg px-3 py-2 font-mono text-[0.7rem] text-faint">
        <span class="h-2 w-2 bg-led"></span>
        <span class="h-2 w-2 bg-amber"></span>
        <span class="h-2 w-2 bg-phosphor"></span>
        <span class="ml-2">kernel — panic</span>
      </div>
      <div class="space-y-3 p-6 font-mono text-sm sm:p-8">
        <p class="text-led">! 404 — page not found</p>
        <p class="text-muted"><span class="text-phosphor">$</span> locate <span class="text-fg">requested.page</span></p>
        <p class="text-faint">locate: 0 results — このページは存在しません。</p>
        <p class="pt-4">
          <a href="/" class="link-p">❯ cd ~</a> <span class="text-faint">— ホームに戻る</span>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
