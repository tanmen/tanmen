---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';

const links = [
  { label: 'github', handle: SITE.social.github, href: `https://github.com/${SITE.social.github}` },
  { label: 'x', handle: SITE.social.twitter, href: `https://twitter.com/${SITE.social.twitter}` },
  { label: 'qiita', handle: SITE.social.qiita, href: `https://qiita.com/${SITE.social.qiita}` },
];
---

<BaseLayout title="Contact" description="連絡先">
  <header class="mb-8">
    <p class="font-mono text-xs text-faint">~/contact</p>
    <h1 class="mt-1 text-2xl text-fg">Contact</h1>
  </header>
  <div class="panel [&>a:last-child]:border-b-0">
    {links.map((l) => (
      <a href={l.href} class="row group flex items-baseline gap-4 px-4 py-4 font-mono text-sm" rel="me">
        <span class="w-16 shrink-0 text-faint">{l.label}</span>
        <span class="text-phosphor opacity-60 group-hover:opacity-100">❯</span>
        <span class="text-fg group-hover:text-amber">@{l.handle}</span>
      </a>
    ))}
  </div>
</BaseLayout>
