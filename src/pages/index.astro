---
import BaseLayout from '../layouts/BaseLayout.astro';
import NeonRoom from '../components/islands/NeonRoom.tsx';
import { NAV } from '../site.config';
---

<BaseLayout fullscreen>
  <h1 class="sr-only">Tanmen — 怠惰なプログラマーの部屋 / 怠惰なプログラマーのサイト</h1>
  <nav class="sr-only" aria-label="メニュー">
    {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
  </nav>
  <NeonRoom client:only="react" />
</BaseLayout>
