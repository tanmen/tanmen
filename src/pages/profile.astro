---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';

const LINKS = [
  { label: 'github', href: `https://github.com/${SITE.social.github}`, value: `@${SITE.social.github}` },
  { label: 'x', href: `https://twitter.com/${SITE.social.twitter}`, value: `@${SITE.social.twitter}` },
  { label: 'qiita', href: `https://qiita.com/${SITE.social.qiita}`, value: `@${SITE.social.qiita}` },
  { label: 'blog', href: '/posts', value: '~/posts' },
];
---

<BaseLayout title="Profile" description="tanmen — バックエンド出身のフロントエンドエンジニア。OSS とツールづくりが好き。">
  <header class="mb-8">
    <p class="font-mono text-xs text-faint">~/profile</p>
    <h1 class="mt-1 text-2xl text-fg">Profile</h1>
  </header>

  <div class="prose prose-invert article max-w-none">
    <p>
      <strong>tanmen</strong> — 怠惰なプログラマー。バックエンドエンジニアとして入社し、
      いつのまにかフロントエンドの比率が高くなって、今はフロントエンドエンジニアを名乗っています。
    </p>
    <p>
      OSS と、趣味の道具づくりが好きです。「面倒」を見つけたら小さなツールにして片付けるのが性分で、
      新しい技術を触った所感や、作ったものの話を、この部屋から少しずつ書いています。
    </p>

    <h2>すること</h2>
    <ul>
      <li>フロントエンド開発（新しめの技術を追いがち）</li>
      <li>OSS・自作ツール（不便を埋める小物が中心）</li>
      <li>技術メモ・所感の発信（<a href="/posts">Blog</a> / Qiita）</li>
    </ul>
  </div>

  <div class="panel mt-8 [&>a:last-child]:border-b-0">
    {LINKS.map((l) => (
      <a
        href={l.href}
        class="row group flex items-baseline gap-4 px-4 py-3.5 font-mono text-sm"
        rel="me"
      >
        <span class="w-20 shrink-0 text-faint">{l.label}</span>
        <span class="text-phosphor opacity-60 transition-opacity group-hover:opacity-100">❯</span>
        <span class="text-fg transition-colors group-hover:text-amber">{l.value}</span>
      </a>
    ))}
  </div>
</BaseLayout>
